{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "hamdi-photography",
  "main": "./worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
